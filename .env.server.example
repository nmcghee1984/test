OPENAI_API_KEY=replace-with-your-local-development-api-key
OPENAI_MODEL=gpt-4.1-mini

# Optional exact browser origins for the local assistant endpoint.
# Default allows only localhost/127.0.0.1 on ports 8084 and 8093.
# API_ALLOWED_ORIGINS=http://localhost:8084,http://127.0.0.1:8084

# Device testing: npm run api:device forces tailscale mode and loopback binding.
# Exact Tailscale logins; no wildcard, token, password or OpenAI key goes in the app.
API_TESTER_LOGINS=your-login@example.com
# Leave unset for existing computer-only npm run api workflow.
# API_ACCESS_MODE=tailscale
