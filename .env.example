API_HOST=127.0.0.1
API_PORT=8787
DATA_DIR=data
EXPO_PUBLIC_DISCOVERY_API_URL=http://localhost:8787

# Optional public OAI-PMH sources; each must be verified before enabling.
ENABLE_RESEARCH_DATA=false
ENABLE_EDSHARE=false

# Bounded harvester defaults (maximum 250 records and 20 pages per source/run).
OAI_MAX_RECORDS=250
OAI_MAX_PAGES=20
OAI_MAX_RESPONSE_BYTES=8388608
OAI_TIMEOUT_MS=20000
OAI_REQUEST_DELAY_MS=1000
OAI_OVERLAP_DAYS=2

# Physical phones: replace localhost with the URL printed by Tailscale Serve.
# EXPO_PUBLIC_DISCOVERY_API_URL=https://your-computer.your-tailnet.ts.net
# Setup: docs/device-testing.md. Never put credentials in EXPO_PUBLIC_*.
